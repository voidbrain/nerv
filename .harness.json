    "tools/check-conventions.mjs": "angular/tools/check-conventions.mjs"
  },
  "forked": {},
  "freshness": {
    "auditDays": 7
  },
  "impact": [
    {
      "id": "frontend",
      "when": [
        "web/**",
        "angular.json",
        "package*.json"
      ],
      "then": "Build and inspect the Angular workspace; reconcile README and style guide.",
      "run": "npm run build",
      "checked": "Angular compiler and browser acceptance F-004",
      "after": []
    },
    {
      "id": "core",
      "when": [
        "src/**",
        "test/**"
      ],
      "then": "Run core regression tests and reconcile the architecture and commands.",
      "run": "npm test",
      "checked": "Restart, duplicate delivery, cancellation and HTTP tests",
      "after": []
    }
  ],
  "couplings": [],
  "outside": [
    {
      "what": "Node SQLite API and Angular dependencies",
      "affects": "Runtime, builds and persistence compatibility",
      "noticed": "Pinned install, regression tests and doctor"
    },
    {
      "what": "Host clock and timezone",
      "affects": "Reminder deadlines",
      "noticed": "Explicit timezone inputs and doctor"
    }
  ],
  "pages": [
    {
      "title": "Architecture",
      "path": "docs/ARCHITECTURE.md",
      "about": "Implemented and intended boundaries"
    }
  ],
  "adapted": {
    "AGENTS.md": [
      "core/AGENTS.md",
      "angular/AGENTS.angular.md"
    ],
    "CLAUDE.md": "core/CLAUDE.md",
    "README.md": "core/README.md",
    "docs/BACKLOG.md": "core/docs/BACKLOG.md",
    "docs/BACKLOG-RULES.md": "core/docs/BACKLOG-RULES.md",
    "docs/STYLE-GUIDE.md": "core/docs/STYLE-GUIDE.md",
    "docs/agents/areas.md": "core/docs/agents/areas.md",
    "docs/audits/README.md": "core/docs/audits/README.md",
    "docs/archive/README.md": "core/docs/archive/README.md",
    ".editorconfig": "core/.editorconfig",
    ".gitignore": "core/gitignore.txt",
    "package.json": "angular/package-scripts.json"
  },
  "ciStatus": {
    "workflow": "CI",
    "browserJobs": "e2e|browser",
    "logNotes": []
  },
  "maintenance": {
    "enabled": true,
    "reviewDays": 7,
    "requireMeasurement": true,
    "inputs": [
      "AGENTS.md",
      "docs/BACKLOG-RULES.md",
      "docs/agents/areas.md",
      "docs/agents/maintenance.md"
    ]
  },
  "audit": {
    "days": 7,
    "enforce": false
  },
  "conventions": {
    "pureDirs": []
  }
}
