{
  "name": "nerv-agency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --use-system-ca src/cli.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "ng build",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "check:harness": "node tools/check-harness.mjs",
    "check:audits": "node tools/check-audits.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:integrations": "node tools/mcp.mjs check",
    "check:conventions": "node tools/check-conventions.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "test:headless": "node --test test/*.integration.ts",
    "backlog:recap": "node tools/backlog-recap.mjs",
    "check:recap": "node tools/backlog-recap.mjs --check",
    "roadmap:status": "node tools/roadmap-status.mjs",
    "check:roadmap": "node tools/roadmap-status.mjs --check",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts test/*.test.mjs && node tools/lcov-summary.mjs",
    "coverage": "npm run test:coverage && node tools/coverage-table.mjs --write",
    "test:browser": "node --test test/angular.browser.mjs",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "check:rules": "node tools/check-rules.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@anthropic-ai/sdk": "1.1.0",
    "ajv": "8.20.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "axe-core": "4.14.0",
    "linkedom": "0.18.12",
    "typescript": "~6.0.2"
  },
  "bin": {
    "nerv": "src/cli.ts"
  }
}
