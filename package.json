{
  "name": "nerv-agency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --use-system-ca src/cli.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "ng build",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "check:harness": "node tools/check-harness.mjs",
    "check:audits": "node tools/check-audits.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:integrations": "node tools/mcp.mjs check",
    "check:conventions": "node tools/check-conventions.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "test:headless": "node --test test/*.integration.ts",
    "backlog:recap": "node tools/backlog-recap.mjs",
    "check:recap": "node tools/backlog-recap.mjs --check",
    "roadmap:status": "node tools/roadmap-status.mjs",
    "check:roadmap": "node tools/roadmap-status.mjs --check",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.ts test/*.test.mjs && node tools/lcov-summary.mjs",
    "coverage": "npm run test:coverage && node tools/coverage-table.mjs --write",
    "test:browser": "node tools/evaluate.mjs --only=browser",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "check:rules": "node tools/check-rules.mjs",
    "check:dependencies": "node tools/backlog-dependencies.mjs --check",
    "check:queue": "node tools/backlog-queue.mjs --check",
    "evals": "node tools/evaluate.mjs",
    "check:evals": "node tools/evaluate.mjs --check",
    "evals:model": "node tools/evaluate-model.mjs",
    "evals:stress": "node tools/evaluate.mjs --repeat=3",
    "verification:plan": "node tools/plan-verification.mjs",
    "test:affected": "node tools/selected-tests.mjs",
    "work:build": "node tools/work-items.mjs build",
    "check:work": "node tools/work-items.mjs check",
    "work:tasks": "node tools/work-items.mjs tasks",
    "work:claims": "node tools/task-claims.mjs",
    "gauntlet:plan": "node tools/gauntlet.mjs plan",
    "gauntlet:run": "node tools/gauntlet.mjs run",
    "gauntlet:model-plan": "node tools/gauntlet.mjs model-plan",
    "gauntlet:model-run": "node tools/gauntlet.mjs model-run",
    "gauntlet:compare": "node tools/gauntlet.mjs compare",
    "gauntlet:qualify": "node tools/gauntlet.mjs qualify",
    "gauntlet:index": "node tools/gauntlet.mjs index",
    "check:gauntlet-index": "node tools/gauntlet.mjs index --check",
    "gauntlet:packs": "node tools/gauntlet.mjs packs",
    "gauntlet:all": "node tools/gauntlet.mjs all",
    "gauntlet:pending": "node tools/gauntlet.mjs pending",
    "gauntlet:ledger": "node tools/gauntlet.mjs ledger",
    "check:gauntlet-runs": "node tools/gauntlet.mjs pending --check-records",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check:tooling": "node tools/check-tooling.mjs",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck && npm run check:work && npm run check:backlog && npm run check:recap && npm run check:roadmap && npm run check:dependencies && npm run check:queue && npm run check:rules && npm run check:maintenance",
    "worktree:link": "ln -sfn ../NERV/node_modules node_modules",
    "work:usage": "node tools/work-usage.mjs",
    "work:launch": "node tools/usage-launch.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@anthropic-ai/sdk": "1.1.0",
    "ajv": "8.20.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@voidbrain/gauntlet-protocol": "file:vendor/voidbrain-gauntlet-protocol-0.7.1.tgz",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "linkedom": "0.18.12",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2"
  },
  "bin": {
    "nerv": "src/cli.ts"
  }
}
