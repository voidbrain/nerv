{
  "schemaVersion": 1,
  "runners": {
    "scripted-agent": {
      "command": "node",
      "args": [
        "tools/gauntlet-scripted-agent.mjs",
        "{report}",
        "{configuration}",
        "{budget}",
        "{case}"
      ],
      "cwd": "../..",
      "layers": [
        "end-to-end"
      ],
      "allowModels": false
    },
    "policy": {
      "command": "node",
      "args": [
        "tools/gauntlet-adapter.mjs",
        "--group=policy",
        "--out={report}"
      ],
      "cwd": "../..",
      "layers": [
        "system"
      ],
      "allowModels": false
    },
    "ledger": {
      "command": "node",
      "args": [
